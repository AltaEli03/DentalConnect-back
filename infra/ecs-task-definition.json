{
  "family": "DentalConnectApi",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "512",
  "executionRoleArn": "REPLACE_WITH_ECS_EXECUTION_ROLE_ARN",
  "containerDefinitions": [
    {
      "name": "api",
      "image": "REPLACE_WITH_IMAGE_URI",
      "essential": true,
      "portMappings": [{ "containerPort": 3000, "protocol": "tcp" }],
      "environment": [
        { "name": "FRONTEND_ORIGIN", "value": "REPLACE_WITH_FRONTEND_ORIGIN" },
        { "name": "PORT", "value": "3000" },
        { "name": "DB_HOST", "value": "REPLACE_WITH_DATABASE_HOST" },
        { "name": "DB_PORT", "value": "5432" },
        { "name": "DB_NAME", "value": "dentalconnect" },
        { "name": "COGNITO_USER_POOL_ID", "value": "REPLACE_WITH_COGNITO_USER_POOL_ID" },
        { "name": "COGNITO_CLIENT_ID", "value": "REPLACE_WITH_COGNITO_CLIENT_ID" },
        { "name": "AWS_REGION", "value": "us-east-1" }
      ],
      "secrets": [
        { "name": "DB_USERNAME", "valueFrom": "REPLACE_WITH_DATABASE_SECRET_ARN:username::" },
        { "name": "DB_PASSWORD", "valueFrom": "REPLACE_WITH_DATABASE_SECRET_ARN:password::" }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/dentalconnect-api",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "api"
        }
      }
    }
  ]
}
