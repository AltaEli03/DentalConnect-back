{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DentalConnectAuthUserPoolOnly",
      "Effect": "Allow",
      "Action": [
        "cognito-idp:AdminCreateUser",
        "cognito-idp:AdminDeleteUser",
        "cognito-idp:AdminGetUser",
        "cognito-idp:AdminSetUserPassword",
        "cognito-idp:AdminUpdateUserAttributes"
      ],
      "Resource": "arn:aws:cognito-idp:us-east-1:918897410823:userpool/us-east-1_hVMMVyRtS"
    },
    {
      "Sid": "DentalConnectVerificationRecordsOnly",
      "Effect": "Allow",
      "Action": [
        "dynamodb:DeleteItem",
        "dynamodb:PutItem",
        "dynamodb:UpdateItem"
      ],
      "Resource": "arn:aws:dynamodb:us-east-1:918897410823:table/DentalConnectClinics"
    }
  ]
}
